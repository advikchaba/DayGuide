# ---------------------------------------------------------------------------
# Routinery backend configuration
# Copy this file to `backend/.env` and fill in the values.
# Every value below has a working local default, so the API boots with no .env
# ---------------------------------------------------------------------------

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_ORIGINS=

# --- Database -------------------------------------------------------------
# Local dev (zero setup):
DATABASE_URL=sqlite:///./routinery.db
# Supabase Postgres (production) - use the Session pooler URI:
# DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase auth + storage ---------------------------------------------
# Project Settings -> API Keys. The new dashboard names (PUBLISHABLE/SECRET)
# and the legacy names (ANON/SERVICE_ROLE) both work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases (either pair is enough):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# The API creates this public Storage bucket on the first photo upload.
SUPABASE_STORAGE_BUCKET=proofs
# Project Settings -> API -> JWT Settings -> JWT Secret (legacy HS256 secret).
# Leave blank to verify access tokens against the Supabase Auth server instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Local dev auth -------------------------------------------------------
# When Supabase is not configured the API can issue its own dev tokens so you
# can run the whole app offline. It is disabled automatically as soon as both
# SUPABASE_URL and SUPABASE_ANON_KEY are set, so unverified/fake emails cannot
# sign in alongside real Supabase accounts.
DEV_AUTH=true
DEV_JWT_SECRET=routinery-dev-secret-change-me

# --- Photo verification ---------------------------------------------------
# mock  -> heuristic auto-approval (great for local development)
# openai-> real vision model checks the photo against the claimed task
# off   -> every proof goes to the manual review queue
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
# Only used by the mock provider: auto-approve plausible photos.
AUTO_APPROVE_PROOFS=true

# Comma separated list of emails allowed to review queued proofs
ADMIN_EMAILS=

UPLOAD_DIR=uploads
# Vercel Functions cap request bodies at ~4.5 MB. The frontend compresses
# photos before upload; set this below the platform limit.
MAX_UPLOAD_BYTES=8000000
# Only needed if you fall back to local disk on a deployed API. Example:
# PUBLIC_BASE_URL=https://your-api.vercel.app
