# Leave blank in local development: Vite proxies /api to http://127.0.0.1:8000.
# Leave blank on Vercel too: the root vercel.json routes /api to the FastAPI
# service in the same project, so requests are same-origin.
# Only set this when the frontend and backend are separate Vercel projects:
# VITE_API_URL=https://routinery-api.vercel.app
VITE_API_URL=

# Optional override. Normally the frontend reads Supabase config from
# GET /api/config, so you do not need these.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
