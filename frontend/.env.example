# Frontend configuration
# Leave these blank to run against the local backend dev-auth provider.
# Fill them in from Supabase -> Project Settings -> API to enable Google OAuth
# and hosted email/password accounts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the API lives. Leave empty to use the Vite proxy (recommended locally).
VITE_API_URL=
