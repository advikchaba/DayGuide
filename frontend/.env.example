# Leave blank in local development: Vite proxies /api to http://127.0.0.1:8000.
# On Vercel, set this to the deployed FastAPI project URL, for example:
# VITE_API_URL=https://routinery-api.vercel.app
VITE_API_URL=

# Optional override. Normally the frontend reads Supabase config from
# GET /api/config, so you do not need these.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
